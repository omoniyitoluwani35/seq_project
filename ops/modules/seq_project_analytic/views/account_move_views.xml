<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Journal Entries: find entries that touch a project, matched through
         their lines. An entry can touch more than one project, so this is a
         "contains" filter, not a classification of the entry. -->
    <record id="view_account_move_filter_project" model="ir.ui.view">
        <field name="name">account.move.search.project</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_account_move_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <field name="line_ids"
                       string="Project"
                       filter_domain="[('line_ids.project_analytic_id', 'ilike', self)]"/>
            </xpath>
        </field>
    </record>

</odoo>
