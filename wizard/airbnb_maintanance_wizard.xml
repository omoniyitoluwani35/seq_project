<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_airbnb_maintenance_wizard_form" model="ir.ui.view">
        <field name="name">airbnb.maintenance.wizard.form</field>
        <field name="model">airbnb.maintenance.wizard</field>
        <field name="arch" type="xml">
            <form string="Put Unit Under Maintenance">
                <group>
                    <field name="unit_id"/>
                    <field name="reason" placeholder="e.g. AC unit failed, awaiting parts"/>
                    <field name="maintenance_from"/>
                    <field name="maintenance_to"/>
                </group>
                <footer>
                    <button name="action_confirm" type="object"
                            string="Confirm" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="view_airbnb_maintenance_end_wizard_form" model="ir.ui.view">
        <field name="name">airbnb.maintenance.end.wizard.form</field>
        <field name="model">airbnb.maintenance.end.wizard</field>
        <field name="arch" type="xml">
            <form string="Return Unit to Service">
                <group>
                    <field name="unit_id"/>
                    <field name="original_reason" readonly="1"/>
                    <field name="resolution" placeholder="e.g. Compressor replaced, tested and working"/>
                </group>
                <footer>
                    <button name="action_confirm" type="object"
                            string="Confirm" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>