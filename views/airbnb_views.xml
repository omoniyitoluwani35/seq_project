    <record id="action_airbnb_ical_block" model="ir.actions.act_window">
        <field name="name">Airbnb Calendar Blocks</field>
        <field name="res_model">airbnb.ical.block</field>
        <field name="view_mode">list</field>
        <field name="context">{'search_default_unmatched': 1}</field>
    </record>

    <record id="view_airbnb_ical_block_search" model="ir.ui.view">
        <field name="name">airbnb.ical.block.search</field>
        <field name="model">airbnb.ical.block</field>
        <field name="arch" type="xml">
            <search>
                <field name="unit_id"/>
                <filter name="unmatched" string="Needs Review"
                        domain="[('is_unmatched','=',True)]"/>
                <group>
                    <filter name="group_unit" string="Unit" context="{'group_by':'unit_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_airbnb_ical_block" model="ir.actions.act_window">
        <field name="name">Airbnb Calendar Blocks</field>
        <field name="res_model">airbnb.ical.block</field>
        <field name="view_mode">list</field>
        <field name="context">{'search_default_unmatched': 1}</field>
    </record>

    <record id="action_airbnb_property" model="ir.actions.act_window">
        <field name="name">Properties</field>
        <field name="res_model">airbnb.property</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_airbnb_unit" model="ir.actions.act_window">
        <field name="name">Units</field>
        <field name="res_model">airbnb.unit</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_airbnb_reservation" model="ir.actions.act_window">
        <field name="name">Reservations</field>
        <field name="res_model">airbnb.reservation</field>
        <field name="view_mode">gantt,list,form</field>
    </record>
