<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="cron_airbnb_ical_import" model="ir.cron">
        <field name="name">Airbnb: Import unit calendars</field>
        <field name="model_id" ref="model_airbnb_unit"/>
        <field name="state">code</field>
        <field name="code">model._cron_import_ical()</field>
        <field name="interval_number">30</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
    </record>

