<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        noupdate="1" deliberately: once this exists, a module upgrade must
        not reset it. The income account in particular is the accountant's
        choice, and a deploy should never overwrite what they set.
    -->
    <data noupdate="1">

        <record id="product_guest_discount" model="product.template">
            <field name="name">Guest Discount</field>
            <field name="default_code">DISCOUNT</field>
            <field name="type">service</field>
            <field name="invoice_policy">order</field>
            <field name="list_price">0.0</field>
            <field name="sale_ok" eval="True"/>
            <field name="purchase_ok" eval="False"/>
            <field name="taxes_id" eval="[(5, 0, 0)]"/>
            <field name="supplier_taxes_id" eval="[(5, 0, 0)]"/>
            <field name="description_sale">Discount agreed with the guest at the desk.</field>
        </record>

    </data>
</odoo>